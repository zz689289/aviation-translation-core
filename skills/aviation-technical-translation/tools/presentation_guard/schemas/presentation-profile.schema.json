{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "$defs": {"ref": {"type": "object", "additionalProperties": false,
    "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["path", "sha256"]}},
  "properties": {
    "version": {"const": 1}, "basis": {"enum": ["SOURCE_EVIDENCE", "OUTPUT_MEASURED"]},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "units": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["metric", "role", "text", "pixels"]},
        "authority": {"enum": ["source_measurement", "scoped_decision"]},
        "value": {}, "unit": {"type": "string", "minLength": 1},
        "pixel_context": {"type": "object", "additionalProperties": false,
          "properties": {"renderer": {"type": "string", "minLength": 1}, "color_space": {"type": "string", "minLength": 1}, "sample_grid": {"type": "string", "minLength": 1}},
          "required": ["renderer", "color_space", "sample_grid"]},
        "abs_tolerance": {"type": "number", "minimum": 0},
        "locator": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
      }, "required": ["id", "kind", "value", "locator", "evidence"]
    }}
  }, "required": ["version", "basis", "artifact_sha256", "units"]
}
