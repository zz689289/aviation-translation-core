{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aviation-technical-translation/table.schema.json",
  "title": "Bilingual Word table",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_locator", "columns", "rows", "header_row_count", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "source_locator": {
      "type": "object",
      "required": ["page"],
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "uniqueItems": true}
      }
    },
    "caption": {"type": "object", "additionalProperties": false, "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "position": {"enum": ["above", "below", "embedded", "none"]}}},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_text", "target_text"],
        "properties": {
          "id": {"type": "string"}, "source_text": {"type": "string"}, "target_text": {"type": "string"},
          "width_cm": {"type": "number", "exclusiveMinimum": 0}, "alignment": {"enum": ["left", "center", "right"]}, "data_type": {"type": "string"}
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cells"],
        "properties": {
          "id": {"type": "string"},
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_text", "target_text"],
              "properties": {
                "source_text": {"type": "string"}, "target_text": {"type": "string"}, "kind": {"enum": ["text", "number", "formula"]},
                "formula_id": {"type": "string"}, "rowspan": {"type": "integer", "minimum": 1}, "colspan": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "header_row_count": {"type": "integer", "minimum": 0},
    "style_profile": {"type": "string"},
    "allow_row_break": {"type": "boolean"},
    "qa_flags": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_asset_id", "method"],
      "properties": {
        "source_asset_id": {"type": "string", "minLength": 1},
        "method": {"enum": ["manual", "pdf_text", "ocr", "machine_alignment", "imported_map", "synthetic_fixture"]},
        "revision": {"type": "string"},
        "decision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
