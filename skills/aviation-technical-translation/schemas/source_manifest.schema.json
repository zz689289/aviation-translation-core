{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aviation-technical-translation/source_manifest.schema.json",
  "title": "Input inventory and workflow selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_root", "locked", "requested_mode", "selected_mode", "allow_downgrade", "capabilities", "inputs", "selection_reasons", "blocking_issues", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_root": {"type": "string"},
    "locked": {"type": "boolean"},
    "requested_mode": {"enum": ["auto", "translation_only", "publication_grade_docx"]},
    "selected_mode": {"enum": ["translation_only", "publication_grade_docx"]},
    "cost_profile": {"enum": ["economy", "balanced", "maximum_quality"]},
    "escalation_mode": {"enum": ["manual_handoff", "auto_escalate"]},
    "layout_profile_id": {"enum": ["source_faithful", "zh_formal_print", "personal_zh_review", "personal_paper_review"]},
    "allow_downgrade": {"type": "boolean"},
    "scan_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_default_excludes", "default_excludes", "active_default_excludes", "additional_excludes", "include_overrides", "hidden_directories_excluded"],
      "properties": {
        "use_default_excludes": {"type": "boolean"},
        "default_excludes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "active_default_excludes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "additional_excludes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "include_overrides": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "hidden_directories_excluded": {"type": "boolean"}
      }
    },
    "excluded_directories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string"},
          "reason": {"enum": ["default_exclude", "additional_exclude", "hidden_directory"]}
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["microsoft_word", "authoritative_renderer"],
      "properties": {
        "microsoft_word": {"type": "boolean"},
        "word_registration_detected": {"type": "boolean"},
        "authoritative_renderer": {"enum": ["word-com", "other", "none"]},
        "renderer_available": {"type": "boolean"},
        "word_com_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "verified", "status"],
          "properties": {
            "requested": {"type": "boolean"},
            "verified": {"type": "boolean"},
            "status": {"enum": ["not_requested", "unsupported_platform", "probe_dependency_missing", "probe_failed", "verified"]},
            "version": {"type": "string"},
            "detail": {"type": "string"}
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "path", "media_type", "language", "authority_rank", "required", "read_only", "authoritative", "sha256", "size_bytes", "detection"],
        "properties": {
          "id": {"type": "string"}, "role": {"enum": ["source_document", "translation_reference", "terminology", "localized_figure", "brand_asset", "layout_reference", "template", "structured_content", "layout_spec", "unclassified"]},
          "path": {"type": "string"}, "media_type": {"type": "string"}, "language": {"type": "string"}, "authority_rank": {"type": "integer", "minimum": 1},
          "required": {"type": "boolean"}, "read_only": {"type": "boolean"}, "authoritative": {"type": "boolean"}, "approved": {"type": "boolean"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "declaration_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "size_bytes": {"type": "integer", "minimum": 0}, "page_count": {"type": "integer", "minimum": 1}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1},
          "detection": {"type": "object", "additionalProperties": false, "required": ["method", "confidence"], "properties": {"method": {"enum": ["declared", "content", "filename_hint", "unknown"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
        }
      }
    },
    "selection_reasons": {"type": "array", "items": {"type": "string"}},
    "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
